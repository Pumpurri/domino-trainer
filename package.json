{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark-engine.mjs",
    "benchmark:quick": "node --experimental-strip-types scripts/benchmark-engine.mjs --quick",
    "benchmark:latency": "node --experimental-strip-types scripts/benchmark-analysis-latency.mjs",
    "benchmark:reliability": "node --experimental-strip-types scripts/benchmark-analyzer-reliability.mjs",
    "benchmark:reliability:quick": "node --experimental-strip-types scripts/benchmark-analyzer-reliability.mjs --quick",
    "benchmark:reliability:overnight": "node --experimental-strip-types scripts/benchmark-analyzer-reliability.mjs --positions-per-phase=100 --repetitions=3 --budgets=120,500,2000 --adaptive-stages=120,250,500,1000,2000 --reference-samples=5000 --confidence-resamples=2000 --workers=6 --checkpoint=outputs/adaptive-reliability-400.checkpoint --json=benchmarks/adaptive-reliability-400.json --report=benchmarks/adaptive-reliability-400.md",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
